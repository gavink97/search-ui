FROM node:20.8-alpine3.18 AS base

ENV LANG=C.UTF-8


FROM base AS deps

RUN apk add --no-cache libc6-compat

WORKDIR /web

COPY --link package.json yarn.lock* package-lock.json* pnpm-lock.yaml* ./

RUN npm ci


FROM base AS builder

WORKDIR /web

COPY --from=deps --link /web/node_modules ./node_modules

COPY --link . .

COPY ./next.config.js next.config.js

# Using buildx Google Inter font will fail unless on VPN

RUN npm run build


FROM base AS runner

WORKDIR /web

ENV NODE_ENV=production

COPY --from=builder --link /web/public ./public

RUN : \
&& adduser --system --uid 1001 nextjs \
&& addgroup --system --gid 1001 nodejs \
&& mkdir .next \
&& chown nextjs:nodejs .next\
&& :

COPY --from=builder --link /web/next.config.js next.config.js

COPY --from=builder --chown=nextjs:node /web/.next/standalone ./

COPY --from=builder --chown=nextjs:node /web/.next/static ./.next/static

RUN : \
&& apk add --no-cache curl \
&& rm -f /sbin/apk \
&& rm -rf /etc/apk \
&& rm -rf /lib/apk \
&& rm -rf /usr/share/apk \
&& rm -rf /var/lib/apk \
&& :

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
